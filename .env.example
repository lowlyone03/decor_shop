# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/decor_shop

# Auth (dùng chuỗi ngẫu nhiên >= 32 ký tự)
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=your-very-long-random-secret-here

# CORS (danh sách domain được phép, cách nhau bằng dấu phẩy)
ALLOWED_ORIGINS=http://localhost:5000

# VNPay (lấy từ cổng thanh toán VNPay)
VNPAY_TMN_CODE=your_tmn_code
VNPAY_HASH_SECRET=your_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5000/api/payments/vnpay-return

# Brevo SMTP Email
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_email@example.com
SMTP_PASS=your_brevo_smtp_password
EMAIL_FROM="Casa Decor" <your_brevo_email@example.com>
